{
  "name": "glade",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint . --deny-warnings",
    "clean": "rm -rf node_modules .turbo apps/*/node_modules apps/*/dist",
    "lint:strict": "oxlint . --config .oxlint-strict.json --deny-warnings"
  },
  "devDependencies": {
    "oxlint": "1.51.0",
    "turbo": "^2.8.17",
    "@oxlint/plugins": "1.51.0"
  },
  "engines": {
    "bun": "^1.3.10",
    "node": "^25.6.1"
  }
}
