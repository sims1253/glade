---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Glade — Reference">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500&display=swap');

    :root {
      --bg: #ffffff;
      --ink: #111827;
      --secondary: #374151;
      --muted: #6b7280;
      --border: #e5e7eb;
      --border-strong: #d1d5db;
      --surface: #f9fafb;
      --accent: #1d4ed8;
      --accent-border: #93c5fd;
      --accent-bg: #eff6ff;
      --green: #15803d;
      --green-border: #86efac;
      --green-bg: #dcfce7;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
    }

    .page {
      max-width: 820px;
      margin: 0 auto;
      padding: 0 32px 80px;
    }

    /* Top bar */
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 0;
      border-bottom: 2px solid var(--ink);
      margin-bottom: 40px;
    }

    .logo {
      display: flex;
      align-items: baseline;
      gap: 2px;
    }

    .logo-name {
      font-family: 'JetBrains Mono', monospace;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.04em;
    }

    .logo-ver {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      color: var(--muted);
      margin-left: 4px;
    }

    .topbar-right {
      display: flex;
      gap: 16px;
      font-size: 12px;
      color: var(--muted);
    }

    .topbar-right a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 500;
    }

    /* Page title */
    .page-title {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--muted);
      margin-bottom: 8px;
    }

    .page-title-sub {
      font-size: 13px;
      color: var(--muted);
    }

    /* Two-col layout */
    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      margin-bottom: 40px;
    }

    .two-col-right {
      border-left: 2px solid var(--border);
      padding-left: 40px;
    }

    /* Section */
    .section {
      margin-bottom: 32px;
    }

    .section h2 {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted);
      margin-bottom: 12px;
    }

    .section p {
      font-size: 13px;
      line-height: 1.75;
      color: var(--secondary);
      margin-bottom: 10px;
    }

    .section p:last-child { margin-bottom: 0; }

    .section p code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11.5px;
      background: var(--surface);
      padding: 1px 4px;
      border: 1px solid var(--border);
      border-radius: 3px;
      color: var(--green);
    }

    /* Definition list */
    .def-list {
      list-style: none;
      margin-bottom: 10px;
    }

    .def-list dt {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11.5px;
      font-weight: 600;
      color: var(--ink);
      margin-bottom: 2px;
    }

    .def-list dd {
      padding: 0 0 0 16px;
      font-size: 13px;
      line-height: 1.65;
      color: var(--secondary);
      border-left: 1px solid var(--border);
      margin-bottom: 8px;
    }

    .def-list dd:last-child { border-bottom: none; margin-bottom: 0; }

    /* Inline code */
    code:not(pre code) {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11.5px;
      background: var(--surface);
      padding: 1px 4px;
      border: 1px solid var(--border);
      border-radius: 3px;
      color: var(--green);
    }

    /* Code block */
    pre {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 14px 18px;
      margin: 12px 0;
      overflow-x: auto;
    }

    pre code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      line-height: 1.7;
    }

    pre .comment { color: var(--muted); }
    pre .fn { color: var(--accent); }
    pre .string { color: var(--green); }

    /* Note callout */
    .note {
      background: var(--accent-bg);
      border: 1px solid var(--accent-border);
      border-radius: 4px;
      padding: 10px 14px;
      margin: 12px 0;
      font-size: 12px;
      line-height: 1.6;
      color: var(--secondary);
    }

    .note strong {
      color: var(--ink);
    }

    /* Spec table */
    .spec-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      margin: 12px 0;
    }

    .spec-table th {
      text-align: left;
      font-weight: 600;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      border-bottom: 2px solid var(--border-strong);
      padding: 6px 12px;
      white-space: nowrap;
    }

    .spec-table td {
      padding: 6px 12px;
      border-bottom: 1px solid var(--border);
      color: var(--secondary);
      vertical-align: top;
    }

    .spec-table td:first-child {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--ink);
      white-space: nowrap;
    }

    /* Configuration block */
    .config-block {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 4px;
      margin: 12px 0;
    }

    .config-block pre {
      margin: 0;
      background: transparent;
      border: none;
      padding: 0;
    }

    /* Footer */
    .page-footer {
      padding: 16px 0;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      color: var(--muted);
    }

    @media (max-width: 640px) {
      .two-col { grid-template-columns: 1fr; }
      .two-col-right { border-left: none; padding-left: 0; }
    }
  </style>

  <div class="page">
    <div class="topbar">
      <div class="logo">
        <span class="logo-name">glade</span>
        <span class="logo-ver">v0.13.2</span>
      </div>
      <div class="topbar-right">
        <a href="#">Docs</a>
        <a href="#">Source</a>
      </div>
    </div>

    <div class="page-title">Reference Documentation</div>
    <p class="page-title-sub">
      Bayesian workflow environment &middot; Technical specification
    </p>

    <div class="two-col">
      <div>
        <div class="section">
          <h2>Overview</h2>
          <p>
            Glade is a desktop application for Bayesian statistical workflow management.
            It represents each step of an analysis as a connected node in an
            <code>directed acyclic graph</code>, maintains a persistent connection to a
            Bayesgrove R session, and surfaces protocol-aware obligations from the
            analysis state.
          </p>
          <p>
            The application is implemented as a cross-platform desktop application using
            <code>Electron</code> with a React web rendering layer and a Bun-based local
            server that communicates with the R process over WebSocket.
          </p>
        </div>

        <div class="section">
          <h2>Installation</h2>
          <pre><span class="comment"># Install the Glade desktop application</span>
<span class="fn">curl</span> -fsSL https://glade.dev/install.sh | <span class="fn">sh</span>

<span class="comment"># Install the Bayesgrove R package</span>
<span class="prompt">&gt;</span> install.packages(<span class="string">"bayesgrove"</span>)

<span class="comment"># Initialize a new project</span>
<span class="prompt">$</span> <span class="fn">glade</span> init <span class="flag">--path</span> ./my-analysis</pre>

          <div class="note">
            <strong>Note:</strong> Glade requires R &ge; 4.3. The Bayesgrove
            package must be installed in your R session before first use. The
            R executable path is auto-detected, but can be overridden in Settings.
          </div>
        </div>

        <div class="section">
          <h2>Configuration</h2>
          <div class="spec-table">
            <thead>
              <tr>
                <th>Field</th>
                <th>Type</th>
                <th>Default</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>projectPath</code></td>
                <td>string</td>
                <td><code>~/.glade/project</code></td>
              </tr>
              <tr>
                <td><code>rExecutablePath</code></td>
                <td>string</td>
                <td><code>auto</code></td>
              </tr>
              <tr>
                <td><code>editorCommand</code></td>
                <td>string</td>
                <td><code>auto</code></td>
              </tr>
              <tr>
                <td><code>updateChannel</code></td>
                <td>union</td>
                <td><code>stable</code></td>
              </tr>
            </tbody>
          </div>
        </div>

        <div class="section">
          <h2>Keyboard Shortcuts</h2>
          <div class="def-list">
            <dt><code>Ctrl + `</code></dt>
            <dd>Toggle the R REPL panel</dd>
          </div>
          <div class="def-list">
            <dt><code>Ctrl + Shift + F</code></dt>
            <dd>Zoom canvas to fit all nodes</dd>
          </div>
          <div class="def-list">
            <dt><code>Ctrl + G</code></dt>
            <dd>Open node search dialog</dd>
          </div>
          <div class="def-list">
            <dt><code>Ctrl + Shift + O</code></dt>
            <dd>Open obligation panel</dd>
          </div>
          <div class="def-list">
            <dt><code>Ctrl + Shift + A</code></dt>
            <dd>Open action panel</dd>
          </div>
        </div>
      </div>

      <div class="two-col-right">
        <div class="section">
          <h2>Node Types</h2>
          <div class="def-list">
            <dt><code>data</code></dt>
            <dd>Data source or transformation step</dd>
          </div>
          <div class="def-list">
            <dt><code>prior</code></dt>
            <dd>Prior distribution specification</dd>
          </div>
          <div class="def-list">
            <dt><code>model</code></dt>
            <dd>Model fitting operation</dd>
          </div>
          <div class="def-list">
            <dt><code>diagnostic</code></dt>
            <dd>Posterior diagnostic check</dd>
          </div>
          <div class="def-list">
            <dt><code>comparison</code></dt>
            <dd>Branch or model comparison</dd>
          </div>
          <div class="def-list">
            <dt><code>decision</code></dt>
            <dd>Recorded decision point</dd>
          </div>
        </div>

        <div class="section">
          <h2>Obligation Protocol</h2>
          <p>
            Obligations are managed through the Bayesgrove protocol and surfaced in Glade as
            interactive panels. Each obligation includes:
          </p>
          <div class="def-list">
            <dt><strong>Scope</strong></dt>
            <dd>The protocol scope the obligation belongs to</dd>
          </div>
          <div class="def-list">
            <dt><strong>Severity</strong></dt>
            <dd><code>blocking</code> (must resolve before proceeding) or <code>advisory</code> (informational)</dd>
          </div>
          <div class="def-list">
            <dt><strong>Affected Nodes</strong></dt>
            <dd>Node IDs referenced by the obligation</dd>
          </div>
        </div>

        <div class="section">
          <h2>Action Protocol</h2>
          <p>
            Actions are Bayesgrove-recommended operations presented to the user for approval.
            Each action includes invocation fields, which can be:
          </p>
          <div class="def-list">
            <dt><code>dropdown</code></dt>
            <dd>Select from predefined options</dd>
          </div>
          <div class="def-list">
            <dt><code>text</code></dt>
            <dd>Free-text input for notes or descriptions</dd>
          </div>
          <div class="def-list">
            <dt><code>multiline</code></dt>
            <dd>Multi-line text area for longer content</dd>
          </div>

          <div class="note">
            <strong>Execution requires explicit user confirmation.</strong> Actions are not
            executed automatically. The <code>executeAction</code> command dispatches
            the action to Bayesgrove only after confirmation.
          </div>
        </div>
      </div>
    </div>

    <footer class="page-footer">
      <span>MIT License &middot; glade.dev</span>
      <span>v0.13.2 &middot; {new Date().getFullYear()}</span>
    </footer>
  </div>
</Layout>
