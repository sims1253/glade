---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Glade — Terminal">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');
    :root {
      --bg: #0a0a0a;
      --green: #00ff41;
      --green-dim: #00cc33;
      --green-glow: rgba(0, 255, 65, 0.08);
      --amber: #ffb000;
      --red: #ff3c3c;
      --surface: #111111;
      --surface-raised: #1a1a1a;
      --border: #222222;
      --text-dim: #555555;
      --text-muted: #888888;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scrollbar-width: thin; scrollbar-color: var(--border) var(--bg); }
    body { font-family: 'IBM Plex Mono', 'Courier New', monospace; background: var(--bg); color: var(--green); min-height: 100vh; overflow-x: hidden; }
    body::after { content: ''; position: fixed; inset: 0; background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0, 0, 0, 0.08) 2px, rgba(0, 0, 0, 0.08) 4px); pointer-events: none; z-index: 9999; }
    @keyframes flicker { 0%, 100% { opacity: 1; } 92% { opacity: 1; } 93% { opacity: 0.9; } 94% { opacity: 1; } 96% { opacity: 0.95; } 97% { opacity: 1; } }
    .terminal { max-width: 880px; margin: 0 auto; padding: 0 16px; animation: flicker 8s infinite; }
    .header-bar { display: flex; align-items: center; justify-content: space-between; padding: 16px 0; border-bottom: 1px solid var(--border); margin-bottom: 0; }
    .header-bar-left { display: flex; align-items: center; gap: 12px; }
    .cursor-block { width: 12px; height: 18px; background: var(--green); animation: blink 1s steps(1) infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    .header-title { font-family: 'Space Mono', monospace; font-size: 13px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; }
    .header-version { font-size: 11px; color: var(--text-dim); letter-spacing: 0.1em; }
    .header-status { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--green-dim); }
    .status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); box-shadow: 0 0 8px var(--green); animation: pulse-dot 2s ease infinite; }
    @keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
    .boot { padding: 40px 0; border-bottom: 1px solid var(--border); }
    .boot-line { font-size: 13px; line-height: 2; color: var(--text-muted); opacity: 0; animation: typeIn 0.3s ease forwards; }
    .boot-line:nth-child(1) { animation-delay: 0.2s; }
    .boot-line:nth-child(2) { animation-delay: 0.5s; }
    .boot-line:nth-child(3) { animation-delay: 0.8s; }
    .boot-line:nth-child(4) { animation-delay: 1.1s; }
    .boot-line:nth-child(5) { animation-delay: 1.4s; color: var(--green); font-weight: 600; }
    .boot-line:nth-child(6) { animation-delay: 1.7s; }
    @keyframes typeIn { from { opacity: 0; transform: translateX(-4px); } to { opacity: 1; transform: translateX(0); } }
    .boot-line .prompt { color: var(--green); }
    .boot-line .success { color: var(--green); }
    .boot-line .warn { color: var(--amber); }
    .boot-line .dim { color: var(--text-dim); }
    .hero { padding: 48px 0 40px; border-bottom: 1px solid var(--border); }
    .ascii-art { font-family: 'Space Mono', monospace; font-size: 7px; line-height: 1.15; color: var(--green); white-space: pre; opacity: 0; animation: typeIn 0.6s ease 2.0s forwards; overflow: hidden; }
    .tagline { margin-top: 24px; font-size: 18px; font-weight: 600; letter-spacing: 0.02em; opacity: 0; animation: typeIn 0.4s ease 2.5s forwards; }
    .tagline-accent { color: var(--amber); }
    .features { padding: 40px 0; border-bottom: 1px solid var(--border); display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--border); }
    .feature-card { background: var(--bg); padding: 32px 24px; border: 1px solid transparent; transition: all 0.2s ease; position: relative; }
    .feature-card::before { content: attr(data-index); position: absolute; top: 12px; right: 16px; font-size: 64px; font-weight: 700; color: var(--surface); line-height: 1; pointer-events: none; font-family: 'Space Mono', monospace; }
    .feature-card:hover { border-color: var(--green); background: var(--green-glow); }
    .feature-card .card-label { font-size: 9px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--amber); margin-bottom: 12px; }
    .feature-card h3 { font-size: 15px; font-weight: 700; margin-bottom: 8px; letter-spacing: 0.02em; }
    .feature-card p { font-size: 12px; line-height: 1.7; color: var(--text-muted); }
    .commands { padding: 48px 0; border-bottom: 1px solid var(--border); }
    .commands-title { font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 24px; }
    .cmd-row { display: flex; align-items: baseline; gap: 16px; padding: 8px 0; border-bottom: 1px solid var(--surface); font-size: 13px; transition: background 0.15s; padding-left: 4px; padding-right: 4px; }
    .cmd-row:hover { background: var(--surface); }
    .cmd-prompt { color: var(--green); white-space: nowrap; user-select: none; }
    .cmd-code { color: var(--amber); }
    .cmd-comment { color: var(--text-dim); margin-left: auto; white-space: nowrap; }
    .install-section { padding: 56px 0 64px; text-align: center; }
    .install-block { display: inline-block; background: var(--surface); border: 1px solid var(--border); padding: 20px 32px; font-size: 14px; text-align: left; position: relative; }
    .install-block::before { content: '$'; color: var(--green); font-weight: 700; margin-right: 8px; }
    .install-note { margin-top: 16px; font-size: 11px; color: var(--text-dim); letter-spacing: 0.05em; }
    .footer { padding: 20px 0 32px; font-size: 10px; color: var(--text-dim); letter-spacing: 0.15em; text-transform: uppercase; display: flex; justify-content: space-between; }
    @media (max-width: 640px) {
      .features { grid-template-columns: 1fr; }
      .ascii-art { font-size: 5px; }
      .header-version { display: none; }
    }
  </style>

  <div class="terminal">
    <div class="header-bar">
      <div class="header-bar-left">
        <div class="cursor-block"></div>
        <span class="header-title">glade</span>
        <span class="header-version">v0.16.2</span>
      </div>
      <div class="header-status">
        <div class="status-dot"></div>
        <span>session active</span>
      </div>
    </div>
    <div class="boot">
      <div class="boot-line"><span class="prompt">&gt;</span> Initializing Bayesgrove runtime...</div>
      <div class="boot-line"><span class="prompt">&gt;</span> R process <span class="success">connected</span> <span class="dim">(pid 48291)</span></div>
      <div class="boot-line"><span class="prompt">&gt;</span> Workflow graph <span class="success">loaded</span> <span class="dim">(12 nodes, 18 edges)</span></div>
      <div class="boot-line"><span class="prompt">&gt;</span> Desktop bridge <span class="success">ready</span></div>
      <div class="boot-line"><span class="prompt">&gt;</span> Workspace <span class="success">initialized</span></div>
      <div class="boot-line">&nbsp;</div>
    </div>
    <div class="hero">
      <pre class="ascii-art">
    ██████╗ ███████╗ ██████╗ ██████╗ ███╗   ██╗
    ██╔══██╗██╔════╝██╔═══██╗██╔══██╗████╗  ██║
    ██████╔╝█████╗  ██║   ██║██████╔╝██╔██╗ ██║
    ██╔══██╗██╔══╝  ██║   ██║██╔══██╗██║╚██╗██║
    ██████╔╝███████╗╚██████╔╝██║  ██║██║ ╚████║
    ╚═════╝ ╚══════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═══╝
      </pre>
      <p class="tagline">Visual Bayesian workflows. <span class="tagline-accent">For people who think in graphs.</span></p>
    </div>
    <div class="features">
      <div class="feature-card" data-index="01"><p class="card-label">[core]</p><h3>Workflow Graph</h3><p>Interactive node-based canvas for building and navigating Bayesian analysis pipelines.</p></div>
      <div class="feature-card" data-index="02"><p class="card-label">[runtime]</p><h3>Live R Session</h3><p>Embedded REPL with full Bayesgrove access. Run diagnostics without context-switching.</p></div>
      <div class="feature-card" data-index="03"><p class="card-label">[protocol]</p><h3>Obligations</h3><p>Blocking and advisory review tasks surfaced automatically from your workflow state.</p></div>
      <div class="feature-card" data-index="04"><p class="card-label">[actions]</p><h3>Execution Engine</h3><p>Preview, confirm, and run bayesgrove-recommended actions with full parameter inspection.</p></div>
    </div>
    <section class="commands">
      <p class="commands-title">// quick reference</p>
      <div class="cmd-row"><span class="cmd-prompt">&gt;</span><span class="cmd-code">glade workspace init</span><span class="cmd-comment"># create new project</span></div>
      <div class="cmd-row"><span class="cmd-prompt">&gt;</span><span class="cmd-code">glade node add --kind model</span><span class="cmd-comment"># add model node</span></div>
      <div class="cmd-row"><span class="cmd-prompt">&gt;</span><span class="cmd-code">glade fit --prior normal</span><span class="cmd-comment"># run model fit</span></div>
      <div class="cmd-row"><span class="cmd-prompt">&gt;</span><span class="cmd-code">glade diagnostics --all</span><span class="cmd-comment"># check all nodes</span></div>
      <div class="cmd-row"><span class="cmd-prompt">&gt;</span><span class="cmd-code">glade export --format pdf</span><span class="cmd-comment"># save workflow</span></div>
    </section>
    <section class="install-section">
      <div class="install-block">bun install -g glade && glade init</div>
      <p class="install-note">requires bun >= 1.3 &middot; works on macOS, linux, windows</p>
    </section>
    <footer class="footer"><span>glade v0.16.2</span><span>bayesgrove ecosystem</span><span>{new Date().getFullYear()}</span></footer>
  </div>
</Layout>
