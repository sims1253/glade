---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Glade">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Instrument+Serif:ital@0;1&display=swap');
    :root {
      --void: #080808; --surface: #0f0f0f; --surface-raised: #161616; --border: #1e1e1e;
      --gold: #c9a84c; --gold-dim: rgba(201, 168, 76, 0.15); --gold-glow: rgba(201, 168, 76, 0.06);
      --silver: #8a8a8a; --silver-dim: #555555; --mist: #2a2a2a; --white: #e8e4dc;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Cormorant Garamond', 'Georgia', serif; background: var(--void); color: var(--silver); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
    body::before { content: ''; position: fixed; inset: 0; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.025'/%3E%3C/svg%3E"); pointer-events: none; z-index: 9999; }
    .page { max-width: 1000px; margin: 0 auto; padding: 0 40px; }
    .top-nav { display: flex; align-items: center; justify-content: space-between; padding: 40px 0; border-bottom: 1px solid var(--border); }
    .logo { font-family: 'Instrument Serif', serif; font-size: 24px; color: var(--white); letter-spacing: 0.04em; }
    .logo-dot { color: var(--gold); }
    .nav-links { display: flex; gap: 32px; list-style: none; }
    .nav-links a { font-family: 'Instrument Serif', serif; font-size: 16px; color: var(--silver-dim); text-decoration: none; transition: color 0.4s; }
    .nav-links a:hover { color: var(--gold); }
    .hero { padding: 120px 0 100px; }
    .hero-overline { font-size: 11px; letter-spacing: 0.35em; text-transform: uppercase; color: var(--gold); margin-bottom: 32px; }
    .hero h1 { font-family: 'Instrument Serif', serif; font-size: clamp(52px, 8vw, 88px); font-weight: 400; line-height: 1.05; color: var(--white); letter-spacing: -0.02em; max-width: 700px; }
    .hero h1 em { font-style: italic; color: var(--gold); }
    .hero-rule { width: 48px; height: 1px; background: var(--gold); margin: 40px 0; }
    .hero-desc { font-size: 20px; font-weight: 300; line-height: 1.8; color: var(--silver); max-width: 460px; }
    .hero-cta { margin-top: 48px; display: inline-flex; align-items: center; gap: 12px; font-family: 'Cormorant Garamond', serif; font-size: 14px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); text-decoration: none; border: 1px solid var(--gold); padding: 16px 40px; transition: all 0.4s ease; }
    .hero-cta:hover { background: var(--gold); color: var(--void); }
    .hero-cta .arrow { transition: transform 0.4s ease; }
    .hero-cta:hover .arrow { transform: translateX(4px); }
    .divider { height: 1px; background: var(--border); margin: 0 -40px; padding: 0 40px; }
    .stats { display: grid; grid-template-columns: repeat(4, 1fr); padding: 64px 0; text-align: center; }
    .stat { position: relative; }
    .stat:not(:last-child)::after { content: ''; position: absolute; right: 0; top: 10%; height: 80%; width: 1px; background: var(--border); }
    .stat-value { font-family: 'Instrument Serif', serif; font-size: 42px; color: var(--white); line-height: 1; margin-bottom: 8px; }
    .stat-label { font-size: 12px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--silver-dim); }
    .features-section { padding: 80px 0; }
    .section-overline { font-size: 11px; letter-spacing: 0.35em; text-transform: uppercase; color: var(--gold); margin-bottom: 16px; }
    .section-title { font-family: 'Instrument Serif', serif; font-size: 40px; color: var(--white); margin-bottom: 56px; }
    .features-list { display: grid; gap: 0; }
    .feature-row { display: grid; grid-template-columns: 80px 1fr; gap: 40px; padding: 40px 0; border-top: 1px solid var(--border); align-items: start; transition: all 0.4s ease; padding-left: 12px; padding-right: 12px; }
    .feature-row:hover { background: var(--surface); }
    .feature-num { font-family: 'Instrument Serif', serif; font-size: 28px; color: var(--gold-dim); padding-top: 4px; }
    .feature-row:hover .feature-num { color: var(--gold); }
    .feature-row h3 { font-family: 'Instrument Serif', serif; font-size: 24px; color: var(--white); margin-bottom: 8px; }
    .feature-row p { font-size: 17px; line-height: 1.7; color: var(--silver); max-width: 520px; }
    .quote-section { padding: 80px 0; text-align: center; }
    .quote-mark { font-family: 'Instrument Serif', serif; font-size: 80px; color: var(--gold-dim); line-height: 0.5; margin-bottom: 24px; }
    .quote-text { font-family: 'Instrument Serif', serif; font-size: 28px; font-weight: 300; font-style: italic; color: var(--white); line-height: 1.6; max-width: 600px; margin: 0 auto 24px; }
    .quote-attr { font-size: 13px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--silver-dim); }
    .final-cta { padding: 80px 0 100px; text-align: center; }
    .final-cta h2 { font-family: 'Instrument Serif', serif; font-size: 48px; color: var(--white); margin-bottom: 12px; }
    .final-cta p { font-size: 18px; color: var(--silver-dim); margin-bottom: 40px; }
    .final-cta .hero-cta { margin-top: 0; }
    .site-footer { padding: 32px 0; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: var(--silver-dim); }
    .site-footer .logo { font-size: 18px; }
    @keyframes reveal { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    .top-nav { animation: reveal 0.6s ease both 0.1s; }
    .hero-overline { animation: reveal 0.6s ease both 0.3s; }
    .hero h1 { animation: reveal 0.8s ease both 0.4s; }
    .hero-rule { animation: reveal 0.6s ease both 0.6s; }
    .hero-desc { animation: reveal 0.6s ease both 0.7s; }
    .hero-cta { animation: reveal 0.6s ease both 0.8s; }
    .stat { opacity: 0; animation: reveal 0.5s ease both; }
    .stat:nth-child(1) { animation-delay: 0.9s; }
    .stat:nth-child(2) { animation-delay: 1.0s; }
    .stat:nth-child(3) { animation-delay: 1.1s; }
    .stat:nth-child(4) { animation-delay: 1.2s; }
    .feature-row { opacity: 0; animation: reveal 0.5s ease both; }
    .feature-row:nth-child(1) { animation-delay: 1.3s; }
    .feature-row:nth-child(2) { animation-delay: 1.4s; }
    .feature-row:nth-child(3) { animation-delay: 1.5s; }
    .feature-row:nth-child(4) { animation-delay: 1.6s; }
    .quote-section { animation: reveal 0.8s ease both 1.7s; }
    .final-cta { animation: reveal 0.6s ease both 1.8s; }
    @media (max-width: 768px) { .page { padding: 0 20px; } .stats { grid-template-columns: repeat(2, 1fr); gap: 32px; } .stat:nth-child(2)::after { display: none; } .feature-row { grid-template-columns: 1fr; gap: 12px; } .nav-links { display: none; } }
  </style>

  <div class="page">
    <header class="top-nav"><div class="logo">glade<span class="logo-dot">.</span></div><ul class="nav-links"><li><a href="#">Features</a></li><li><a href="#">Documentation</a></li><li><a href="#">GitHub</a></li></ul></header>
    <section class="hero">
      <p class="hero-overline">Bayesian Modeling Reimagined</p>
      <h1>Where precision<br>meets <em>clarity</em></h1>
      <div class="hero-rule"></div>
      <p class="hero-desc">A refined desktop environment for Bayesian statistical modeling. Visual, structured, and designed for analysts who value both rigor and elegance.</p>
      <a href="#" class="hero-cta">Begin your workflow <span class="arrow">&rarr;</span></a>
    </section>
    <div class="divider"></div>
    <section class="stats">
      <div class="stat"><div class="stat-value">v0.13</div><div class="stat-label">Current Release</div></div>
      <div class="stat"><div class="stat-value">R</div><div class="stat-label">Native Runtime</div></div>
      <div class="stat"><div class="stat-value">3</div><div class="stat-label">Platforms</div></div>
      <div class="stat"><div class="stat-value">&infin;</div><div class="stat-label">Workflows</div></div>
    </section>
    <div class="divider"></div>
    <section class="features-section">
      <p class="section-overline">Capabilities</p>
      <h2 class="section-title">Crafted for depth</h2>
      <div class="features-list">
        <article class="feature-row"><div class="feature-num">01</div><div><h3>Workflow Graph</h3><p>An interactive canvas where every model, diagnostic, and decision becomes a connected node.</p></div></article>
        <article class="feature-row"><div class="feature-num">02</div><div><h3>Shared REPL</h3><p>A live R session running alongside your graph. Inspect data, test priors, and explore results.</p></div></article>
        <article class="feature-row"><div class="feature-num">03</div><div><h3>Obligation Tracking</h3><p>Bayesgrove surfaces validation checkpoints and review tasks as interactive cards.</p></div></article>
        <article class="feature-row"><div class="feature-num">04</div><div><h3>Controlled Execution</h3><p>Preview every recommended action with full parameter disclosure before committing.</p></div></article>
      </div>
    </section>
    <div class="divider"></div>
    <section class="quote-section">
      <div class="quote-mark">&ldquo;</div>
      <p class="quote-text">Finally, a tool that treats Bayesian workflows with the visual respect they deserve.</p>
      <p class="quote-attr">The Bayesgrove Community</p>
    </section>
    <div class="divider"></div>
    <section class="final-cta"><h2>Get started today</h2><p>Free, open source, and available on every platform.</p><a href="#" class="hero-cta">Download Glade <span class="arrow">&rarr;</span></a></section>
    <footer class="site-footer"><span class="logo">glade<span class="logo-dot">.</span></span><span>{new Date().getFullYear()}</span></footer>
  </div>
</Layout>
