---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Glade — Geometric">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=Space+Grotesk:wght@300;400;500;600;700&display=swap');
    :root {
      --bg: #f2ece0; --ink: #0d0d0d; --red: #e63946; --blue: #1d3557; --teal: #2ec4b6;
      --yellow: #ff9f1c; --pink: #ff6b9d; --purple: #7b2cbf; --grid-line: rgba(13, 13, 13, 0.06);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Space Grotesk', sans-serif; background: var(--bg); color: var(--ink); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
    body::before { content: ''; position: fixed; inset: 0; background-image: linear-gradient(var(--grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--grid-line) 1px, transparent 1px); background-size: 60px 60px; pointer-events: none; z-index: 0; }
    .page { position: relative; z-index: 1; }
    .top-bar { display: flex; align-items: center; justify-content: space-between; padding: 24px 40px; max-width: 1280px; margin: 0 auto; }
    .brand { font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800; text-transform: uppercase; letter-spacing: -0.02em; display: flex; align-items: center; gap: 8px; }
    .brand-shape { width: 28px; height: 28px; background: var(--red); transform: rotate(45deg); border-radius: 4px; }
    .top-links { display: flex; gap: 8px; }
    .top-links a { font-family: 'Syne', sans-serif; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink); text-decoration: none; padding: 10px 18px; border: 2px solid var(--ink); transition: all 0.2s ease; }
    .top-links a:hover { background: var(--ink); color: var(--bg); }
    .hero { max-width: 1280px; margin: 0 auto; padding: 60px 40px 80px; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
    .hero-content { position: relative; }
    .hero-tag { display: inline-block; font-family: 'Syne', sans-serif; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.2em; background: var(--yellow); padding: 6px 16px; transform: rotate(-2deg); margin-bottom: 24px; }
    .hero h1 { font-family: 'Syne', sans-serif; font-size: clamp(48px, 6vw, 72px); font-weight: 800; line-height: 0.95; letter-spacing: -0.04em; text-transform: uppercase; margin-bottom: 24px; }
    .hero h1 .line-accent { display: block; color: var(--bg); -webkit-text-stroke: 2px var(--ink); }
    .hero h1 .line-color { display: block; color: var(--red); }
    .hero-desc { font-size: 16px; line-height: 1.7; max-width: 420px; margin-bottom: 32px; }
    .hero-cta-row { display: flex; gap: 12px; }
    .btn-solid { font-family: 'Syne', sans-serif; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; background: var(--ink); color: var(--bg); padding: 14px 28px; text-decoration: none; border: 2px solid var(--ink); transition: all 0.2s; display: inline-block; }
    .btn-solid:hover { background: var(--red); border-color: var(--red); color: white; transform: translate(-2px, -2px); box-shadow: 4px 4px 0 var(--ink); }
    .btn-outline { font-family: 'Syne', sans-serif; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; background: transparent; color: var(--ink); padding: 14px 28px; text-decoration: none; border: 2px solid var(--ink); transition: all 0.2s; display: inline-block; }
    .btn-outline:hover { background: var(--ink); color: var(--bg); transform: translate(-2px, -2px); box-shadow: 4px 4px 0 var(--red); }
    .hero-visual { position: relative; height: 420px; }
    .geo-shape { position: absolute; transition: transform 0.6s ease; }
    .geo-shape:hover { transform: scale(1.08) rotate(5deg); }
    .geo-rect-1 { width: 260px; height: 180px; background: var(--blue); top: 20px; left: 40px; border: 3px solid var(--ink); box-shadow: 6px 6px 0 var(--ink); }
    .geo-circle { width: 140px; height: 140px; background: var(--teal); border: 3px solid var(--ink); top: 160px; left: 120px; box-shadow: 6px 6px 0 var(--ink); }
    .geo-tri { width: 0; height: 0; border-left: 100px solid transparent; border-right: 100px solid transparent; border-bottom: 170px solid var(--yellow); top: 0; right: 30px; filter: drop-shadow(6px 6px 0 var(--ink)); }
    .geo-rect-2 { width: 160px; height: 100px; background: var(--pink); bottom: 40px; right: 60px; transform: rotate(8deg); border: 3px solid var(--ink); box-shadow: 6px 6px 0 var(--ink); }
    .geo-label { position: absolute; font-family: 'Syne', sans-serif; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.15em; background: white; border: 2px solid var(--ink); padding: 4px 10px; box-shadow: 2px 2px 0 var(--ink); }
    .geo-label-1 { bottom: 240px; left: 60px; }
    .geo-label-2 { bottom: 20px; left: 180px; }
    .geo-label-3 { top: 30px; right: 150px; }
    .ticker-strip { border-top: 3px solid var(--ink); border-bottom: 3px solid var(--ink); padding: 16px 0; overflow: hidden; white-space: nowrap; }
    .ticker-track { display: inline-flex; animation: scroll-left 30s linear infinite; }
    .ticker-item { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; padding: 0 24px; display: inline-flex; align-items: center; gap: 24px; }
    .ticker-sep { width: 8px; height: 8px; background: var(--ink); transform: rotate(45deg); flex-shrink: 0; }
    @keyframes scroll-left { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    .features-bento { max-width: 1280px; margin: 0 auto; padding: 80px 40px; display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: auto auto; gap: 2px; background: var(--ink); }
    .bento-card { background: var(--bg); padding: 40px 32px; border: 3px solid var(--ink); transition: all 0.3s ease; position: relative; }
    .bento-card:hover { transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--ink); }
    .bento-card.wide { grid-column: span 2; }
    .bento-card .card-tag { display: inline-block; font-family: 'Syne', sans-serif; font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.2em; margin-bottom: 16px; padding: 4px 10px; border: 2px solid var(--ink); }
    .bento-card:nth-child(1) .card-tag { background: var(--blue); color: white; border-color: var(--blue); }
    .bento-card:nth-child(2) .card-tag { background: var(--teal); color: white; border-color: var(--teal); }
    .bento-card:nth-child(3) .card-tag { background: var(--yellow); border-color: var(--yellow); }
    .bento-card:nth-child(4) .card-tag { background: var(--pink); color: white; border-color: var(--pink); }
    .bento-card:nth-child(5) .card-tag { background: var(--purple); color: white; border-color: var(--purple); }
    .bento-card h3 { font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800; text-transform: uppercase; letter-spacing: -0.02em; margin-bottom: 12px; }
    .bento-card p { font-size: 14px; line-height: 1.7; max-width: 400px; }
    .process-section { max-width: 1280px; margin: 0 auto; padding: 80px 40px; }
    .process-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 48px; border-bottom: 3px solid var(--ink); padding-bottom: 16px; }
    .process-header h2 { font-family: 'Syne', sans-serif; font-size: 36px; font-weight: 800; text-transform: uppercase; letter-spacing: -0.03em; }
    .process-header p { font-size: 14px; max-width: 300px; text-align: right; }
    .process-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
    .process-step { position: relative; padding: 32px 20px; border: 3px solid var(--ink); transition: all 0.3s ease; }
    .process-step:hover { transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--red); }
    .process-step-num { font-family: 'Syne', sans-serif; font-size: 48px; font-weight: 800; line-height: 1; margin-bottom: 16px; -webkit-text-stroke: 2px var(--ink); color: transparent; }
    .process-step.active .process-step-num { -webkit-text-stroke: 0; color: var(--red); }
    .process-step h4 { font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 8px; }
    .process-step p { font-size: 13px; line-height: 1.6; }
    .cta-banner { background: var(--ink); padding: 80px 40px; text-align: center; position: relative; overflow: hidden; }
    .cta-banner::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 40px 40px; }
    .cta-banner h2 { font-family: 'Syne', sans-serif; font-size: clamp(36px, 5vw, 56px); font-weight: 800; text-transform: uppercase; color: white; letter-spacing: -0.03em; margin-bottom: 16px; position: relative; }
    .cta-banner h2 span { color: var(--red); }
    .cta-banner p { font-size: 16px; color: rgba(255,255,255,0.6); margin-bottom: 32px; position: relative; }
    .cta-banner .btn-solid { background: var(--red); border-color: var(--red); color: white; position: relative; }
    .cta-banner .btn-solid:hover { background: white; color: var(--ink); border-color: white; box-shadow: 6px 6px 0 rgba(255,255,255,0.3); }
    .site-footer { max-width: 1280px; margin: 0 auto; padding: 32px 40px; display: flex; align-items: center; justify-content: space-between; font-family: 'Syne', sans-serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; }
    .footer-shapes { display: flex; gap: 6px; }
    .footer-shapes span { display: inline-block; width: 10px; height: 10px; border: 2px solid var(--ink); }
    .footer-shapes span:nth-child(1) { background: var(--blue); }
    .footer-shapes span:nth-child(2) { background: var(--red); transform: rotate(45deg); }
    .footer-shapes span:nth-child(3) { background: var(--teal); border-radius: 50%; }
    .footer-shapes span:nth-child(4) { background: var(--yellow); }
    @keyframes slamIn { from { opacity: 0; transform: translateX(-40px) rotate(-3deg); } to { opacity: 1; transform: translateX(0) rotate(0); } }
    @keyframes dropIn { from { opacity: 0; transform: translateY(-30px) scale(0.9); } to { opacity: 1; transform: translateY(0) scale(1); } }
    .hero-tag { animation: slamIn 0.5s ease both 0.1s; }
    .hero h1 { animation: slamIn 0.6s ease both 0.2s; }
    .hero-desc { animation: slamIn 0.5s ease both 0.4s; }
    .hero-cta-row { animation: slamIn 0.5s ease both 0.5s; }
    .geo-shape { opacity: 0; animation: dropIn 0.5s ease both; }
    .geo-rect-1 { animation-delay: 0.3s; }
    .geo-tri { animation-delay: 0.5s; }
    .geo-circle { animation-delay: 0.7s; }
    .geo-rect-2 { animation-delay: 0.9s; }
    .geo-label { opacity: 0; animation: dropIn 0.3s ease both 1.1s; }
    @media (max-width: 768px) { .hero { grid-template-columns: 1fr; } .hero-visual { height: 280px; } .features-bento { grid-template-columns: 1fr; } .bento-card.wide { grid-column: span 1; } .process-steps { grid-template-columns: repeat(2, 1fr); } .top-bar { padding: 16px 20px; } .top-links { display: none; } }
  </style>

  <div class="page">
    <div class="top-bar"><div class="brand"><span class="brand-shape"></span>Glade</div><div class="top-links"><a href="/#features">Features</a><a href="https://glade.dev/docs">Docs</a><a href="https://github.com/sims1253/glade">GitHub</a></div></div>
    <section class="hero">
      <div class="hero-content"><div class="hero-tag">Built for Bayesgrove</div><h1>Visual<span class="line-accent">Bayesian</span><span class="line-color">Work</span></h1><p class="hero-desc">A geometric, graph-driven workspace for Bayesian statistical modeling. Drag nodes. Run models. Make decisions.</p><div class="hero-cta-row"><a href="https://github.com/sims1253/glade/releases" class="btn-solid">Download Now</a><a href="https://glade.dev/docs" class="btn-outline">Documentation</a></div></div>
      <div class="hero-visual"><div class="geo-shape geo-rect-1"></div><div class="geo-shape geo-circle"></div><div class="geo-shape geo-tri"></div><div class="geo-shape geo-rect-2"></div><div class="geo-label geo-label-1">Data</div><div class="geo-label geo-label-2">Model</div><div class="geo-label geo-label-3">Decide</div></div>
    </section>
    <div class="ticker-strip"><div class="ticker-track"><span class="ticker-item">Workflow Graph <span class="ticker-sep"></span></span><span class="ticker-item">Live REPL <span class="ticker-sep"></span></span><span class="ticker-item">Obligation Tracking <span class="ticker-sep"></span></span><span class="ticker-item">Action Execution <span class="ticker-sep"></span></span><span class="ticker-item">R Integration <span class="ticker-sep"></span></span><span class="ticker-item">Bayesgrove Protocol <span class="ticker-sep"></span></span><span class="ticker-item">Cross-Platform <span class="ticker-sep"></span></span><span class="ticker-item">Open Source <span class="ticker-sep"></span></span><span class="ticker-item">Workflow Graph <span class="ticker-sep"></span></span><span class="ticker-item">Live REPL <span class="ticker-sep"></span></span><span class="ticker-item">Obligation Tracking <span class="ticker-sep"></span></span><span class="ticker-item">Action Execution <span class="ticker-sep"></span></span><span class="ticker-item">R Integration <span class="ticker-sep"></span></span><span class="ticker-item">Bayesgrove Protocol <span class="ticker-sep"></span></span><span class="ticker-item">Cross-Platform <span class="ticker-sep"></span></span><span class="ticker-item">Open Source <span class="ticker-sep"></span></span></div></div>
    <section class="features-bento">
      <div class="bento-card wide"><span class="card-tag">Core</span><h3>Interactive Workflow Graph</h3><p>Build your Bayesian pipeline as a visual graph with drag, connect, annotate, and navigate.</p></div>
      <div class="bento-card"><span class="card-tag">Runtime</span><h3>Live R REPL</h3><p>Run ad hoc R commands against your Bayesgrove session without leaving the workspace.</p></div>
      <div class="bento-card"><span class="card-tag">Protocol</span><h3>Obligation Cards</h3><p>Blocking and advisory review tasks appear as interactive cards from your workflow state.</p></div>
      <div class="bento-card"><span class="card-tag">Actions</span><h3>Execution Engine</h3><p>Preview and confirm recommended actions with full parameter disclosure.</p></div>
      <div class="bento-card wide"><span class="card-tag">Platform</span><h3>Cross-Platform Desktop</h3><p>Available on macOS, Linux, and Windows with auto-updates.</p></div>
    </section>
    <section class="process-section">
      <div class="process-header"><h2>How it works</h2><p>Four shapes. One workflow.</p></div>
      <div class="process-steps">
        <div class="process-step active"><div class="process-step-num">01</div><h4>Load Data</h4><p>Bring your datasets into the workspace.</p></div>
        <div class="process-step"><div class="process-step-num">02</div><h4>Specify Priors</h4><p>Define prior distributions as connected nodes.</p></div>
        <div class="process-step"><div class="process-step-num">03</div><h4>Fit & Diagnose</h4><p>Run model fits and review diagnostics.</p></div>
        <div class="process-step"><div class="process-step-num">04</div><h4>Decide</h4><p>Execute recommended actions with audit trails.</p></div>
      </div>
    </section>
    <section class="cta-banner"><h2>Build <span>better</span> models</h2><p>Free, open source, built for the Bayesian workflow.</p><a href="https://github.com/sims1253/glade/releases" class="btn-solid">Get Glade</a></section>
    <footer class="site-footer"><span>Glade &copy; {new Date().getFullYear()}</span><div class="footer-shapes"><span></span><span></span><span></span><span></span></div><span>Bayesgrove Ecosystem</span></footer>
  </div>
</Layout>
