---
import Layout from '../layouts/Layout.astro';

const features = [
  { title: 'Visual Workflow Graph', desc: 'Drag, connect, and annotate nodes that represent every step of your Bayesian analysis pipeline.' },
  { title: 'Live R REPL', desc: 'Run ad hoc checks against your Bayesgrove session without leaving the workspace.' },
  { title: 'Protocol-Aware Obligations', desc: 'See blocking and advisory review tasks surfaced automatically from your workflow state.' },
  { title: 'Action Preview & Execution', desc: 'Confirm bayesgrove-recommended actions with full parameter inspection before running.' },
];
---

<Layout title="Glade — Visual Bayesian Workflows">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Source+Serif+4:ital,wght@0,300;0,400;0,600;1,300;1,400&family=JetBrains+Mono:wght@400;500&display=swap');

    :root {
      --ink: #1a1818;
      --paper: #f5f0e8;
      --paper-dark: #ebe4d8;
      --accent: #8b2500;
      --accent-light: #c44d2a;
      --rule: #c4b9a8;
      --rule-light: #d8ceb8;
      --caption: #6b5e4e;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Source Serif 4', 'Georgia', serif;
      background: var(--paper);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
    }
    .page { max-width: 720px; margin: 0 auto; padding: 0 24px; }
    .masthead { padding: 48px 0 0; text-align: center; border-bottom: 3px double var(--rule); }
    .masthead-eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.35em; text-transform: uppercase; color: var(--caption); margin-bottom: 12px; }
    .masthead-title { font-family: 'Playfair Display', serif; font-size: clamp(48px, 8vw, 72px); font-weight: 900; letter-spacing: -0.03em; line-height: 0.9; color: var(--ink); margin-bottom: 16px; }
    .masthead-subtitle { font-family: 'Source Serif 4', serif; font-size: 18px; font-weight: 300; font-style: italic; color: var(--caption); margin-bottom: 12px; line-height: 1.5; }
    .masthead-rule { width: 48px; height: 1px; background: var(--accent); margin: 0 auto 32px; }
    .masthead-meta { display: flex; justify-content: center; gap: 24px; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--caption); padding-bottom: 20px; }
    .abstract { padding: 48px 0; border-bottom: 1px solid var(--rule-light); }
    .abstract-label { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--accent); margin-bottom: 16px; }
    .abstract p { font-size: 17px; line-height: 1.8; color: var(--ink); font-weight: 300; }
    .abstract p + p { margin-top: 20px; }
    .dropcap::first-letter { font-family: 'Playfair Display', serif; float: left; font-size: 64px; font-weight: 900; line-height: 0.8; padding: 6px 8px 0 0; color: var(--accent); }
    .section-head { padding: 48px 0 24px; border-bottom: 1px solid var(--rule-light); }
    .section-number { font-family: 'Playfair Display', serif; font-size: 12px; font-weight: 700; color: var(--accent); margin-bottom: 4px; }
    .section-title { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 700; letter-spacing: -0.02em; }
    .features { padding: 0 0 48px; }
    .feature { padding: 32px 0; border-bottom: 1px solid var(--rule-light); }
    .feature:last-child { border-bottom: none; }
    .feature-ordinal { font-family: 'Playfair Display', serif; font-size: 48px; font-weight: 900; color: var(--paper-dark); line-height: 1; margin-bottom: 8px; }
    .feature h3 { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 8px; }
    .feature p { font-size: 16px; line-height: 1.75; color: var(--caption); font-weight: 300; max-width: 540px; }
    .figure { padding: 40px 0; text-align: center; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
    .figure-box { border: 1px solid var(--rule); background: var(--paper); padding: 48px 32px; margin: 0 16px; position: relative; }
    .figure-box::before { content: ''; position: absolute; top: 8px; left: 8px; right: 8px; bottom: 8px; border: 1px solid var(--rule-light); pointer-events: none; }
    .workflow-demo { display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap; padding: 16px 0; }
    .wf-node { border: 1.5px solid var(--ink); padding: 10px 20px; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; transition: all 0.3s ease; }
    .wf-node:hover { background: var(--ink); color: var(--paper); }
    .wf-node.active { background: var(--accent); border-color: var(--accent); color: var(--paper); }
    .wf-edge { width: 24px; height: 1px; background: var(--rule); }
    .figure-caption { margin-top: 16px; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--caption); }
    .cta { padding: 64px 0 80px; text-align: center; }
    .cta-label { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.35em; text-transform: uppercase; color: var(--caption); margin-bottom: 16px; }
    .cta h2 { font-family: 'Playfair Display', serif; font-size: 32px; font-weight: 700; margin-bottom: 24px; letter-spacing: -0.02em; }
    .cta-link { display: inline-block; font-family: 'Source Serif 4', serif; font-size: 16px; font-weight: 600; color: var(--paper); background: var(--ink); padding: 14px 40px; text-decoration: none; letter-spacing: 0.04em; transition: background 0.2s; }
    .cta-link:hover { background: var(--accent); }
    .footer { border-top: 3px double var(--rule); padding: 24px 0 48px; text-align: center; font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--caption); }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
    .masthead-title { animation: fadeUp 0.8s ease both; }
    .masthead-subtitle { animation: fadeUp 0.8s ease 0.15s both; }
    .masthead-rule { animation: fadeUp 0.8s ease 0.3s both; }
    .masthead-meta { animation: fadeUp 0.8s ease 0.4s both; }
    .abstract { animation: fadeUp 0.8s ease 0.5s both; }
    .figure { animation: fadeUp 0.8s ease 0.6s both; }
    .feature { opacity: 0; animation: fadeUp 0.6s ease both; }
    .feature:nth-child(1) { animation-delay: 0.7s; }
    .feature:nth-child(2) { animation-delay: 0.85s; }
    .feature:nth-child(3) { animation-delay: 1.0s; }
    .feature:nth-child(4) { animation-delay: 1.15s; }
    .cta { animation: fadeUp 0.8s ease 1.3s both; }
  </style>

  <div class="page">
    <header class="masthead">
      <p class="masthead-eyebrow">A Software Environment for</p>
      <h1 class="masthead-title">GLADE</h1>
      <p class="masthead-subtitle">Visual Bayesian statistical modeling<br>through structured workflow graphs</p>
      <div class="masthead-rule"></div>
      <div class="masthead-meta">
        <span>Version 0.13</span>
        <span>&middot;</span>
        <span>Open Source</span>
        <span>&middot;</span>
        <span>Cross-Platform</span>
      </div>
    </header>
    <section class="abstract">
      <p class="abstract-label">Abstract</p>
      <p class="dropcap">Glade is a desktop application that provides a structured, visual interface for Bayesian statistical modeling. Built around the Bayesgrove R package, it transforms the traditional command-driven analysis loop into an interactive graph-based workspace where every model fit, diagnostic check, and decision point is represented as a connected, annotatable node.</p>
      <p>The environment surfaces protocol-aware obligations and recommended actions directly from the analysis state, ensuring that reviewers and analysts never lose sight of critical validation steps.</p>
    </section>
    <div class="figure">
      <div class="figure-box">
        <div class="workflow-demo">
          <div class="wf-node active">Data Load</div>
          <div class="wf-edge"></div>
          <div class="wf-node">Prior Spec</div>
          <div class="wf-edge"></div>
          <div class="wf-node">Model Fit</div>
          <div class="wf-edge"></div>
          <div class="wf-node">Diagnostics</div>
          <div class="wf-edge"></div>
          <div class="wf-node">Decision</div>
        </div>
        <p class="figure-caption">Fig. 1 &mdash; Typical Bayesian analysis workflow in Glade</p>
      </div>
    </div>
    <div class="section-head">
      <p class="section-number">I.</p>
      <h2 class="section-title">Core Capabilities</h2>
    </div>
    <section class="features">
      {features.map((f, i) => (
        <article class="feature">
          <div class="feature-ordinal">{String(i + 1).padStart(2, '0')}</div>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </article>
      ))}
    </section>
    <section class="cta">
      <p class="cta-label">Get Started</p>
      <h2>Begin your first workflow</h2>
      <a href="#" class="cta-link">Download Glade</a>
    </section>
    <footer class="footer">
      <p>Glade &middot; Bayesian workflows for R &middot; {new Date().getFullYear()}</p>
    </footer>
  </div>
</Layout>
