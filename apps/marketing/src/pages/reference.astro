---
import Layout from '../layouts/Layout.astro';

const commands = [
  { cmd: 'glade init [path]', desc: 'Create a new Glade project and start the Bayesgrove R session.' },
  { cmd: 'glade open [path]', desc: 'Open an existing project directory.' },
  { cmd: 'glade node add --kind <type>', desc: 'Add a node to the workflow canvas. Types: data, prior, model, diagnostic, decision.' },
  { cmd: 'glade node connect <from> <to>', desc: 'Create a directed edge between two nodes.' },
  { cmd: 'glade node annotate <id> --notes <text>', desc: 'Attach a text annotation to a node.' },
  { cmd: 'glade fit --node <id>', desc: 'Run model fitting on the specified node.' },
  { cmd: 'glade diagnose --all', desc: 'Run diagnostic checks on all model nodes in the workflow.' },
  { cmd: 'glade obligations', desc: 'List all outstanding blocking and advisory obligations.' },
  { cmd: 'glade actions', desc: 'List recommended actions from the Bayesgrove protocol state.' },
  { cmd: 'glade execute --action <id>', desc: 'Execute a recommended action after confirmation.' },
  { cmd: 'glade repl', desc: 'Open the embedded R REPL in the current project session.' },
  { cmd: 'glade repl detach', desc: 'Detach the REPL into a separate window.' },
  { cmd: 'glade export --format <fmt>', desc: 'Export the workflow. Formats: json, pdf, svg.' },
  { cmd: 'glade settings', desc: 'Open the desktop settings (R path, project dir, editor, updates).' },
  { cmd: 'glade update', desc: 'Check for and apply application updates.' },
];

const shortcuts = [
  { keys: 'Ctrl + `', action: 'Toggle REPL panel' },
  { keys: 'Ctrl + Shift + F', action: 'Zoom to fit canvas' },
  { keys: 'Ctrl + G', action: 'Open node search' },
  { keys: 'Ctrl + Shift + O', action: 'Open obligation panel' },
  { keys: 'Ctrl + Shift + A', action: 'Open action panel' },
  { keys: 'Delete', action: 'Delete selected node(s)' },
  { keys: 'Ctrl + Z', action: 'Undo last canvas action' },
  { keys: 'Ctrl + Shift + Z', action: 'Redo' },
];

const nodeTypes = [
  { type: 'data', icon: 'D', desc: 'Data source or transformation step' },
  { type: 'prior', icon: 'P', desc: 'Prior distribution specification' },
  { type: 'model', icon: 'M', desc: 'Model fitting operation' },
  { type: 'diagnostic', icon: 'X', desc: 'Posterior diagnostic check' },
  { type: 'comparison', icon: 'C', desc: 'Branch or model comparison' },
  { type: 'decision', icon: '!', desc: 'Recorded decision point' },
];
---

<Layout title="Glade — Reference Card">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap');

    :root {
      --bg: #ffffff;
      --ink: #111111;
      --border: #333333;
      --border-light: #cccccc;
      --border-faint: #e5e5e5;
      --surface: #f7f7f7;
      --accent: #1a5276;
      --accent-light: #eaf2f8;
      --dim: #666666;
      --muted: #999999;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: var(--bg);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
    }

    .card {
      max-width: 900px;
      margin: 24px auto;
      padding: 36px 40px 48px;
      border: 2px solid var(--border);
    }

    /* Header */
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding-bottom: 12px;
      border-bottom: 2px solid var(--border);
      margin-bottom: 20px;
    }

    .card-header h1 {
      font-family: 'JetBrains Mono', monospace;
      font-size: 24px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .card-header-right {
      text-align: right;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--dim);
      line-height: 1.6;
    }

    /* One-liner description */
    .tagline {
      font-size: 13px;
      color: var(--dim);
      margin-bottom: 28px;
      line-height: 1.5;
    }

    /* Section headers */
    .section-header {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--accent);
      padding: 4px 0;
      border-bottom: 1px solid var(--border-light);
      margin-bottom: 12px;
      margin-top: 28px;
    }

    /* Command table */
    .cmd-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      margin-bottom: 8px;
    }

    .cmd-table th {
      text-align: left;
      font-weight: 600;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      border-bottom: 1px solid var(--border-light);
      padding: 6px 12px 6px 0;
    }

    .cmd-table td {
      padding: 5px 12px 5px 0;
      border-bottom: 1px solid var(--border-faint);
      vertical-align: top;
    }

    .cmd-table tr:last-child td {
      border-bottom: none;
    }

    .cmd {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11.5px;
      font-weight: 500;
      white-space: nowrap;
      color: var(--ink);
    }

    .cmd .flag {
      color: var(--accent);
    }

    .cmd-desc {
      color: var(--dim);
      font-size: 12px;
      line-height: 1.5;
    }

    /* Shortcut table */
    .shortcut-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      margin-bottom: 8px;
    }

    .shortcut-table th {
      text-align: left;
      font-weight: 600;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      border-bottom: 1px solid var(--border-light);
      padding: 6px 12px 6px 0;
    }

    .shortcut-table td {
      padding: 4px 12px 4px 0;
      border-bottom: 1px solid var(--border-faint);
      vertical-align: top;
    }

    .shortcut-table tr:last-child td {
      border-bottom: none;
    }

    .keys {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      white-space: nowrap;
    }

    .shortcut-action {
      color: var(--dim);
    }

    /* Node types */
    .node-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-bottom: 8px;
    }

    .node-type {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border: 1px solid var(--border-faint);
      font-size: 12px;
    }

    .node-icon {
      width: 24px;
      height: 24px;
      background: var(--accent);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 700;
      flex-shrink: 0;
    }

    .node-type-info {
      display: flex;
      flex-direction: column;
      gap: 1px;
    }

    .node-name {
      font-family: 'JetBrains Mono', monospace;
      font-weight: 600;
      font-size: 11px;
    }

    .node-desc {
      font-size: 11px;
      color: var(--muted);
    }

    /* Requirements row */
    .req-row {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 8px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--dim);
    }

    .req-item strong {
      color: var(--ink);
      font-weight: 500;
    }

    /* Two-column layout */
    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }

    .two-col > div {
      padding-right: 24px;
    }

    .two-col > div:last-child {
      padding-right: 0;
      padding-left: 24px;
      border-left: 1px solid var(--border-faint);
    }

    /* Footer */
    .card-footer {
      margin-top: 32px;
      padding-top: 12px;
      border-top: 2px solid var(--border);
      display: flex;
      justify-content: space-between;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: var(--muted);
    }

    @media (max-width: 700px) {
      .card { padding: 20px 16px 32px; margin: 8px; }
      .two-col { grid-template-columns: 1fr; }
      .two-col > div:last-child { padding-left: 0; border-left: none; padding-top: 20px; border-top: 1px solid var(--border-faint); }
      .node-grid { grid-template-columns: repeat(2, 1fr); }
      .cmd { white-space: normal; }
    }
  </style>

  <div class="card">
    <header class="card-header">
      <div>
        <h1>GLADE</h1>
      </div>
      <div class="card-header-right">
        v0.16.2<br>
        Reference Card<br>
        {new Date().getFullYear()}
      </div>
    </header>

    <p class="tagline">
      Desktop environment for Bayesian statistical workflow management. Visual graph canvas, live R REPL, protocol-aware obligations.
      Requires R &ge; 4.3 and Bayesgrove &ge; 0.8.
    </p>

    <!-- Requirements -->
    <div class="req-row">
      <span><strong>R:</strong> &ge; 4.3</span>
      <span><strong>Bayesgrove:</strong> &ge; 0.8</span>
      <span><strong>macOS:</strong> 13+</span>
      <span><strong>Linux:</strong> glibc 2.35+</span>
      <span><strong>Windows:</strong> 10+</span>
    </div>

    <!-- Commands -->
    <div class="section-header">CLI Reference</div>
    <table class="cmd-table">
      <thead>
        <tr>
          <th style="width:46%">Command</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        {commands.map((c) => (
          <tr>
            <td class="cmd" set:html={c.cmd.replace(/(--\w+)/g, '<span class="flag">$1</span>').replace(/<(\w+)>/g, '&lt;$1&gt;')} />
            <td class="cmd-desc">{c.desc}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <!-- Node types + shortcuts -->
    <div class="two-col">
      <div>
        <div class="section-header">Node Types</div>
        <div class="node-grid">
          {nodeTypes.map((n) => (
            <div class="node-type">
              <div class="node-icon">{n.icon}</div>
              <div class="node-type-info">
                <span class="node-name">{n.type}</span>
                <span class="node-desc">{n.desc}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div>
        <div class="section-header">Keyboard Shortcuts</div>
        <table class="shortcut-table">
          <thead>
            <tr>
              <th style="width:44%">Keys</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            {shortcuts.map((s) => (
              <tr>
                <td class="keys">{s.keys}</td>
                <td class="shortcut-action">{s.action}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <div class="section-header">Configuration</div>
        <div style="font-size:12px;line-height:1.7;color:var(--dim);">
          <p><strong style="color:var(--ink);font-family:'JetBrains Mono',monospace;font-size:11px;">projectPath</strong> &mdash; Glade project directory (default: <code>~/.glade/project</code>)</p>
          <p><strong style="color:var(--ink);font-family:'JetBrains Mono',monospace;font-size:11px;">rExecutablePath</strong> &mdash; R binary path (default: <code>auto</code>)</p>
          <p><strong style="color:var(--ink);font-family:'JetBrains Mono',monospace;font-size:11px;">editorCommand</strong> &mdash; External editor (default: <code>auto</code>)</p>
          <p><strong style="color:var(--ink);font-family:'JetBrains Mono',monospace;font-size:11px;">updateChannel</strong> &mdash; Update channel (default: <code>stable</code>)</p>
        </div>
      </div>
    </div>

    <footer class="card-footer">
      <span>MIT License &middot; github.com/sims1253/glade</span>
      <span>Page 1 of 1</span>
    </footer>
  </div>
</Layout>
