---
import Layout from '../layouts/Layout.astro';
import { version } from '../../../../package.json';
---

<Layout title="Glade — Bayesian Workflow Environment for R">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,400&display=swap');

    :root {
      --bg: #ffffff;
      --surface: #f7f8fa;
      --surface-alt: #f0f2f5;
      --border: #d1d5db;
      --border-light: #e5e7eb;
      --text: #1f2937;
      --text-secondary: #4b5563;
      --text-muted: #6b7280;
      --blue: #2563eb;
      --blue-light: #dbeafe;
      --blue-dark: #1e40af;
      --green: #059669;
      --green-light: #d1fae5;
      --orange: #d97706;
      --orange-light: #fef3c7;
      --code-bg: #f8fafc;
      --code-border: #e2e8f0;
      --sidebar-w: 240px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Source Serif 4', 'Georgia', serif;
      background: var(--bg);
      color: var(--text);
      -webkit-font-smoothing: antialiased;
    }

    /* Sidebar + main layout */
    .shell {
      display: flex;
      min-height: 100vh;
    }

    .sidebar {
      width: var(--sidebar-w);
      background: var(--surface);
      border-right: 1px solid var(--border-light);
      padding: 24px 16px;
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      overflow-y: auto;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
    }

    .sidebar-brand {
      font-weight: 600;
      font-size: 16px;
      color: var(--text);
      margin-bottom: 4px;
    }

    .sidebar-version {
      font-size: 11px;
      color: var(--text-muted);
      margin-bottom: 24px;
    }

    .sidebar-section {
      margin-bottom: 24px;
    }

    .sidebar-section-title {
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 8px;
      font-weight: 600;
    }

    .sidebar-link {
      display: block;
      padding: 5px 8px;
      color: var(--text-secondary);
      text-decoration: none;
      border-radius: 4px;
      transition: background 0.15s;
    }

    .sidebar-link:hover {
      background: var(--surface-alt);
      color: var(--text);
    }

    .sidebar-link.active {
      background: var(--blue-light);
      color: var(--blue-dark);
    }

    .sidebar-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
    }

    .badge {
      display: inline-block;
      padding: 2px 6px;
      border-radius: 3px;
      font-size: 9px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .badge-green { background: var(--green-light); color: #065f46; }
    .badge-blue { background: var(--blue-light); color: var(--blue-dark); }
    .badge-orange { background: var(--orange-light); color: #92400e; }

    /* Main content */
    .main {
      margin-left: var(--sidebar-w);
      padding: 40px 48px 80px;
      max-width: 800px;
    }

    /* Badges row */
    .top-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 32px;
    }

    /* Title */
    .pkg-title {
      font-size: 28px;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .pkg-subtitle {
      font-size: 16px;
      color: var(--text-secondary);
      margin-bottom: 24px;
      line-height: 1.5;
    }

    .pkg-meta {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      padding: 16px 0;
      border-top: 1px solid var(--border-light);
      border-bottom: 1px solid var(--border-light);
      margin-bottom: 32px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
    }

    .meta-label {
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 2px;
    }

    .meta-value {
      color: var(--text);
      font-weight: 500;
    }

    /* Section */
    .section {
      margin-bottom: 40px;
    }

    .section h2 {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border-light);
    }

    .section p {
      font-size: 15px;
      line-height: 1.75;
      color: var(--text-secondary);
      margin-bottom: 12px;
    }

    /* Code blocks */
    .code-block {
      background: var(--code-bg);
      border: 1px solid var(--code-border);
      border-radius: 6px;
      padding: 16px 20px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 13px;
      line-height: 1.7;
      overflow-x: auto;
      margin: 16px 0;
    }

    .code-block .comment { color: var(--text-muted); }
    .code-block .fn { color: var(--blue); }
    .code-block .string { color: var(--green); }
    .code-block .keyword { color: #7c3aed; }

    .code-header {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 8px;
    }

    /* Feature list */
    .feature-list {
      list-style: none;
    }

    .feature-list li {
      padding: 10px 0;
      border-bottom: 1px solid var(--border-light);
      display: flex;
      align-items: baseline;
      gap: 12px;
      font-size: 14px;
      line-height: 1.6;
    }

    .feature-list li:last-child {
      border-bottom: none;
    }

    .feature-bullet {
      width: 6px;
      height: 6px;
      background: var(--blue);
      border-radius: 50%;
      flex-shrink: 0;
      margin-top: 7px;
    }

    /* Workflow diagram */
    .workflow-diagram {
      background: var(--surface);
      border: 1px solid var(--border-light);
      border-radius: 6px;
      padding: 32px 24px;
      margin: 20px 0;
    }

    .workflow-steps {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      flex-wrap: wrap;
    }

    .ws-node {
      padding: 10px 16px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 4px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      color: var(--text);
    }

    .ws-node.highlight {
      border-color: var(--blue);
      background: var(--blue-light);
      color: var(--blue-dark);
    }

    .ws-arrow {
      width: 32px;
      text-align: center;
      color: var(--border);
      font-size: 14px;
    }

    .workflow-caption {
      text-align: center;
      margin-top: 16px;
      font-size: 12px;
      color: var(--text-muted);
    }

    /* Install section */
    .install-rows {
      display: grid;
      gap: 16px;
    }

    .install-row {
      display: grid;
      grid-template-columns: 80px 1fr;
      gap: 16px;
      align-items: start;
    }

    .install-row dt {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      padding-top: 10px;
    }

    .install-row dd .code-block {
      margin: 0;
    }

    /* Footer */
    .pkg-footer {
      margin-top: 60px;
      padding-top: 20px;
      border-top: 1px solid var(--border-light);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      color: var(--text-muted);
      display: flex;
      justify-content: space-between;
    }

    @media (max-width: 900px) {
      .sidebar { display: none; }
      .main { margin-left: 0; padding: 24px 20px; }
      .pkg-meta { grid-template-columns: repeat(2, 1fr); }
      .workflow-steps { gap: 4px; }
      .ws-node { padding: 8px 10px; font-size: 11px; }
    }
  </style>

  <div class="shell">
    <aside class="sidebar">
      <div class="sidebar-brand">glade</div>
      <div class="sidebar-version">{version}</div>

      <div class="sidebar-badges">
        <span class="badge badge-green">stable</span>
        <span class="badge badge-blue">v0.16</span>
      </div>

      <div class="sidebar-section">
        <div class="sidebar-section-title">Documentation</div>
        <a class="sidebar-link active" href="#">Overview</a>
        <a class="sidebar-link" href="#">Installation</a>
        <a class="sidebar-link" href="#">Getting Started</a>
        <a class="sidebar-link" href="#">Workflow Graph</a>
        <a class="sidebar-link" href="#">REPL Reference</a>
        <a class="sidebar-link" href="#">Actions API</a>
        <a class="sidebar-link" href="#">Configuration</a>
      </div>

      <div class="sidebar-section">
        <div class="sidebar-section-title">Resources</div>
        <a class="sidebar-link" href="#">Changelog</a>
        <a class="sidebar-link" href="#">GitHub</a>
        <a class="sidebar-link" href="#">Bayesgrove Docs</a>
        <a class="sidebar-link" href="#">Issue Tracker</a>
      </div>

      <div class="sidebar-section">
        <div class="sidebar-section-title">Depends on</div>
        <a class="sidebar-link" href="#">R &ge; 4.3</a>
        <a class="sidebar-link" href="#">bayesgrove &ge; 0.8</a>
        <a class="sidebar-link" href="#">Bun &ge; 1.3</a>
      </div>
    </aside>

    <main class="main">
      <div class="top-badges">
        <span class="badge badge-green">stable</span>
        <span class="badge badge-blue">cross-platform</span>
        <span class="badge badge-orange">desktop</span>
      </div>

      <h1 class="pkg-title">glade: Bayesian Workflow Environment</h1>
      <p class="pkg-subtitle">A structured, graphical desktop environment for Bayesian statistical modeling with the Bayesgrove R package. Provides an interactive workflow canvas, live R session, and protocol-aware analysis management.</p>

      <div class="pkg-meta">
        <div>
          <div class="meta-label">Version</div>
          <div class="meta-value">{version}</div>
        </div>
        <div>
          <div class="meta-label">License</div>
          <div class="meta-value">MIT</div>
        </div>
        <div>
          <div class="meta-label">Requires</div>
          <div class="meta-value">R &ge; 4.3</div>
        </div>
        <div>
          <div class="meta-label">Platforms</div>
          <div class="meta-value">macOS, Linux, Win</div>
        </div>
      </div>

      <section class="section">
        <h2>Installation</h2>
        <div class="install-rows">
          <dl class="install-row">
            <dt>Desktop</dt>
            <dd>
              <div class="code-block">
                <span class="comment"># Install the Glade desktop application</span><br>
                <span class="keyword">curl</span> -fsSL https://glade.dev/install.sh | <span class="keyword">sh</span>
              </div>
            </dd>
          </dl>
          <dl class="install-row">
            <dt>R package</dt>
            <dd>
              <div class="code-block">
                <span class="comment"># Install Bayesgrove from CRAN</span><br>
                <span class="fn">install.packages</span>(<span class="string">"bayesgrove"</span>)
              </div>
            </dd>
          </dl>
        </div>
      </section>

      <section class="section">
        <h2>Description</h2>
        <p>Glade provides a visual workspace for building and managing Bayesian statistical workflows. Analysis steps are represented as nodes on an interactive graph canvas, connected by edges that encode the logical dependencies of your modeling pipeline.</p>
        <p>The environment maintains a live connection to a Bayesgrove R session through an embedded REPL. This allows analysts to explore data, test priors, and run ad hoc diagnostics without leaving the visual workspace.</p>
        <p>Bayesgrove surfaces protocol-aware obligations &mdash; blocking review steps and advisory checks &mdash; as interactive cards within the interface. Recommended actions can be previewed with full parameter disclosure before execution.</p>
      </section>

      <div class="workflow-diagram">
        <div class="workflow-steps">
          <div class="ws-node highlight">Data</div>
          <div class="ws-arrow">&rarr;</div>
          <div class="ws-node">Priors</div>
          <div class="ws-arrow">&rarr;</div>
          <div class="ws-node highlight">Model</div>
          <div class="ws-arrow">&rarr;</div>
          <div class="ws-node">Diagnostics</div>
          <div class="ws-arrow">&rarr;</div>
          <div class="ws-node">Decision</div>
        </div>
        <p class="workflow-caption">Typical node progression in a Bayesian analysis workflow</p>
      </div>

      <section class="section">
        <h2>Key Features</h2>
        <ul class="feature-list">
          <li>
            <span class="feature-bullet"></span>
            <span><strong>Interactive workflow graph</strong> &mdash; Build analysis pipelines as connected, annotatable nodes with drag-and-drop layout.</span>
          </li>
          <li>
            <span class="feature-bullet"></span>
            <span><strong>Embedded R REPL</strong> &mdash; Live Bayesgrove session with command history, detached window support, and R process output inspection.</span>
          </li>
          <li>
            <span class="feature-bullet"></span>
            <span><strong>Obligation tracking</strong> &mdash; Protocol-aware blocking and advisory review tasks surfaced from the Bayesgrove analysis state.</span>
          </li>
          <li>
            <span class="feature-bullet"></span>
            <span><strong>Action preview</strong> &mdash; Inspect recommended actions with full parameter details, invocation fields, and template references before execution.</span>
          </li>
          <li>
            <span class="feature-bullet"></span>
            <span><strong>Desktop-native</strong> &mdash; File picker integration, auto-updates, external editor launching, and R executable configuration.</span>
          </li>
          <li>
            <span class="feature-bullet"></span>
            <span><strong>Cross-platform</strong> &mdash; Native builds for macOS, Linux, and Windows with automated update channels.</span>
          </li>
        </ul>
      </section>

      <section class="section">
        <h2>Quick Start</h2>
        <p class="code-header">Initialize a new workflow project</p>
        <div class="code-block">
          <span class="comment"># Launch Glade &mdash; the Bayesgrove R session starts automatically</span><br>
          <span class="fn">glade</span> init my-analysis<br><br>
          <span class="comment"># Your first model node is available on the canvas</span><br>
          <span class="comment"># Use the REPL panel (Ctrl+`) for ad hoc R commands</span>
        </div>
      </section>

      <footer class="pkg-footer">
        <span>Glade {version} &middot; Built for Bayesgrove</span>
        <span>{new Date().getFullYear()}</span>
      </footer>
    </main>
  </div>
</Layout>
